{
  "name": "agentlens",
  "version": "0.1.0",
  "description": "Runs a multi-agent Claude pipeline and automatically categorizes why each run succeeded or failed (bad retrieval, bad reasoning, wrong tool call, hallucination).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agentlens": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/retrieval/kb && cp src/retrieval/kb/articles.json dist/retrieval/kb/articles.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@xenova/transformers": "^2.17.2",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dotenv": "^17.2.3",
    "picocolors": "^1.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
